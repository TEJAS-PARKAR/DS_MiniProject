# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
venv/
.venv/
ENV/

# Testing & logs
.pytest_cache/
.coverage
htmlcov/
*.log

# Benchmark result CSVs, raw event traces, summaries, and charts.
#
# Per-run raw files are large (~460 MB for 570 runs) and fully reproducible
# by re-running the experiment suites. Ignore them.
# Suite-level aggregate CSVs, PNG charts, and the markdown report are small
# deliverables and ARE tracked (not ignored here).
#
# Per-run event CSVs  (pattern: <algo>-<n>-<seed>-<uuid>_events.csv)
results/*-*-*-*_events.csv
# Per-run message logs
results/*.jsonl
# Per-run JSON summaries  (pattern: <algo>-<n>-<seed>-<uuid>_summary.json)
results/*-*-*-*_summary.json
